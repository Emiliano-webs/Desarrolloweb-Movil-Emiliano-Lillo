<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>JavaScript & Bootstrap</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <div class="container mt-5">

    <h1 class="mb-4">Ejercicio: Manipulación de Objetos</h1>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">1. delete</h5>
        <p class="card-text">Elimina una propiedad del objeto.</p>
        <button class="btn btn-primary" onclick="ejemplo1()">Ejecutar</button>
        <pre id="resultado1" class="bg-light p-2 mt-2"></pre>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">2. Spread ...</h5>
        <p class="card-text">Copia el objeto y sobrescribe una propiedad.</p>
        <button class="btn btn-primary" onclick="ejemplo2()">Ejecutar</button>
        <pre id="resultado2" class="bg-light p-2 mt-2"></pre>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">3. Object.assign</h5>
        <p class="card-text">Junta dos objetos en uno solo.</p>
        <button class="btn btn-primary" onclick="ejemplo3()">Ejecutar</button>
        <pre id="resultado3" class="bg-light p-2 mt-2"></pre>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">4. Object.entries</h5>
        <p class="card-text">Recorre las propiedades del objeto.</p>
        <button class="btn btn-primary" onclick="ejemplo4()">Ejecutar</button>
        <pre id="resultado4" class="bg-light p-2 mt-2"></pre>
      </div>
    </div>

  </div>

  <script>
    // objeto base
    let objeto = { propiedad1: 1, propiedad2: 2 };

    function ejemplo1() {
      delete objeto.propiedad1;
      document.getElementById("resultado1").textContent = JSON.stringify(objeto);
    }

    let ordenado;
    function ejemplo2() {
      ordenado = { propiedad1: 3, ...objeto };
      document.getElementById("resultado2").textContent = JSON.stringify(ordenado);
    }

    let composicion;
    function ejemplo3() {
      if (!ordenado) ejemplo2();
      let objeto2 = { tipo: "IOT" };
      composicion = Object.assign({}, ordenado, objeto2);
      document.getElementById("resultado3").textContent = JSON.stringify(composicion);
    }

    function ejemplo4() {
      if (!composicion) ejemplo3();
      let texto = "";
      Object.entries(composicion).forEach(([key, value]) => {
        texto += "key: " + key + ", value: " + value + "\n";
      });
      document.getElementById("resultado4").textContent = texto;
    }
  </script>

</body>
</html>